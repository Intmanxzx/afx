# Copy to /etc/afx-platform/backup.env (mode 0600, owned by the service user).
AFX_DATA=/data/afx-platform
AFX_BIN=/opt/afx-platform/venv/bin/afx
# Remote machine that keeps the backups; use a dedicated key with no password.
BACKUP_REMOTE_HOST=backup@backup-host
BACKUP_REMOTE_DIR=/srv/backups/afx-platform
BACKUP_SSH_OPTS="-i /etc/afx-platform/backup_ed25519 -o BatchMode=yes -o ConnectTimeout=20"
# Local staging on the system disk (deleted after upload).
BACKUP_STAGING=/var/tmp/afx-platform-backup
# Fast by default; use 6 for higher compression at the cost of CPU/time.
BACKUP_COMPRESSION_LEVEL=1
# Remote retention.
BACKUP_KEEP_CORE_DAYS=7
BACKUP_KEEP_FULL_DAYS=14
