# Template: replace user, interpreter and data directory with installation paths.
[Unit]
Description=Autofuse Fuzz automatic outbox uploader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=developer
ExecStart=/opt/autofusex/venv/bin/afx fuzz maintenance sync run --data-dir /var/lib/autofusex
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
