www.esay.app {
	redir https://autofuse.online{uri} permanent
}
esay.app {
	# Existing upload clients reject redirects. Keep their API working.
	@api path /api/* /healthz
	handle @api {
		request_body {
			max_size 2MB
		}
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		redir https://autofuse.online{uri} permanent
	}
}
autofuse.online {
	encode gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy 127.0.0.1:8090
}
:80 {
	respond "Use https://autofuse.online" 403
}
